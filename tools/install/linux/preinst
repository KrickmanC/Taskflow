#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo "This installer must run as root."
  exit 1
fi

if ! id taskflow >/dev/null 2>&1; then
  useradd --system --home /var/lib/taskflow --shell /usr/sbin/nologin taskflow
fi

mkdir -p /opt/taskflow /etc/taskflow /var/lib/taskflow /var/log/taskflow
