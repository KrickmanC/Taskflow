[Unit]
Description=Taskflow Admin UI
After=taskflow-api.service
Requires=taskflow-api.service

[Service]
Type=simple
User=taskflow
Group=taskflow
WorkingDirectory=/opt/taskflow/repo/apps/admin
EnvironmentFile=/etc/taskflow/admin.env
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5
StandardOutput=append:/var/log/taskflow/admin.log
StandardError=append:/var/log/taskflow/admin.err.log

[Install]
WantedBy=multi-user.target
