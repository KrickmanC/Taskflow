[Unit]
Description=Taskflow API
After=network.target postgresql.service redis-server.service rabbitmq-server.service taskflow-minio.service
Requires=postgresql.service redis-server.service rabbitmq-server.service taskflow-minio.service

[Service]
Type=simple
User=taskflow
Group=taskflow
WorkingDirectory=/opt/taskflow/repo/apps/api
EnvironmentFile=/etc/taskflow/api.env
ExecStart=/opt/taskflow/venv/bin/python /opt/taskflow/repo/apps/api/bin/native_api_start.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/taskflow/api.log
StandardError=append:/var/log/taskflow/api.err.log

[Install]
WantedBy=multi-user.target
