[Unit]
Description=Taskflow Web UI
After=taskflow-api.service
Requires=taskflow-api.service

[Service]
Type=simple
User=taskflow
Group=taskflow
WorkingDirectory=/opt/taskflow/repo/apps/web
EnvironmentFile=/etc/taskflow/web.env
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5
StandardOutput=append:/var/log/taskflow/web.log
StandardError=append:/var/log/taskflow/web.err.log

[Install]
WantedBy=multi-user.target
