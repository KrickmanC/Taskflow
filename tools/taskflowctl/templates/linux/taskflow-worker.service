[Unit]
Description=Taskflow Celery Worker
After=taskflow-api.service rabbitmq-server.service redis-server.service
Requires=rabbitmq-server.service redis-server.service

[Service]
Type=simple
User=taskflow
Group=taskflow
WorkingDirectory=/opt/taskflow/repo/apps/api
EnvironmentFile=/etc/taskflow/api.env
ExecStart=/opt/taskflow/venv/bin/python /opt/taskflow/repo/apps/api/bin/native_worker_start.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/taskflow/worker.log
StandardError=append:/var/log/taskflow/worker.err.log

[Install]
WantedBy=multi-user.target
