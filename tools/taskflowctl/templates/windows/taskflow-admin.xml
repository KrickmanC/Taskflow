<service>
  <id>taskflow-admin</id>
  <name>Taskflow Admin</name>
  <description>Taskflow Admin UI</description>

  <workingdirectory>C:\Program Files\Taskflow\repo\apps\admin</workingdirectory>
  <executable>C:\Program Files\nodejs\pnpm.cmd</executable>
  <arguments>start</arguments>

  <env name="TASKFLOW_ENV_FILE" value="C:\ProgramData\Taskflow\admin.env"/>

  <logpath>C:\ProgramData\Taskflow\logs</logpath>
  <log mode="roll"/>
  <onfailure action="restart" delay="5 sec"/>
</service>
