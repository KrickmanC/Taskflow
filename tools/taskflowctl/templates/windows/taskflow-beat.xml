<service>
  <id>taskflow-beat</id>
  <name>Taskflow Beat</name>
  <description>Taskflow Celery beat scheduler</description>

  <workingdirectory>C:\Program Files\Taskflow\repo\apps\api</workingdirectory>
  <executable>C:\Program Files\Taskflow\venv\Scripts\python.exe</executable>
  <arguments>C:\Program Files\Taskflow\repo\apps\api\bin\native_beat_start.py</arguments>

  <env name="TASKFLOW_ENV_FILE" value="C:\ProgramData\Taskflow\api.env"/>

  <logpath>C:\ProgramData\Taskflow\logs</logpath>
  <log mode="roll"/>
  <onfailure action="restart" delay="5 sec"/>
</service>
