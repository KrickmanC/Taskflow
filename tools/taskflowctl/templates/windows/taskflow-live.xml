<service>
  <id>taskflow-live</id>
  <name>Taskflow Live</name>
  <description>Taskflow realtime collaboration server</description>

  <workingdirectory>C:\Program Files\Taskflow\repo\apps\live</workingdirectory>
  <executable>C:\Program Files\nodejs\pnpm.cmd</executable>
  <arguments>start</arguments>

  <env name="TASKFLOW_ENV_FILE" value="C:\ProgramData\Taskflow\live.env"/>

  <logpath>C:\ProgramData\Taskflow\logs</logpath>
  <log mode="roll"/>
  <onfailure action="restart" delay="5 sec"/>
</service>
