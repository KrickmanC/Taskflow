<service>
  <id>taskflow-minio</id>
  <name>Taskflow MinIO</name>
  <description>Taskflow local S3-compatible storage</description>

  <workingdirectory>C:\ProgramData\Taskflow</workingdirectory>
  <executable>C:\Program Files\Taskflow\minio\minio.exe</executable>
  <arguments>server C:\ProgramData\Taskflow\minio --console-address ":9090"</arguments>

  <env name="MINIO_ROOT_USER" value="access-key"/>
  <env name="MINIO_ROOT_PASSWORD" value="secret-key"/>

  <logpath>C:\ProgramData\Taskflow\logs</logpath>
  <log mode="roll"/>
  <onfailure action="restart" delay="5 sec"/>
</service>
