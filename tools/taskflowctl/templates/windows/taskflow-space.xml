<service>
  <id>taskflow-space</id>
  <name>Taskflow Space</name>
  <description>Taskflow Space UI</description>

  <workingdirectory>C:\Program Files\Taskflow\repo\apps\space</workingdirectory>
  <executable>C:\Program Files\nodejs\pnpm.cmd</executable>
  <arguments>start</arguments>

  <env name="TASKFLOW_ENV_FILE" value="C:\ProgramData\Taskflow\space.env"/>

  <logpath>C:\ProgramData\Taskflow\logs</logpath>
  <log mode="roll"/>
  <onfailure action="restart" delay="5 sec"/>
</service>
